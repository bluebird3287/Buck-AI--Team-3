{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/download-zip", "destination": "/buckeyelink-advising-assistant.zip" },
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "headers": [
    {
      "source": "/buckeyelink-advising-assistant.zip",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"buckeyelink-advising-assistant.zip\"" }
      ]
    }
  ]
}
