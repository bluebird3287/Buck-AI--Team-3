{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "(python3 scripts/make-project-zip.py || echo 'Skipping project zip') && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/download-zip",
      "destination": "/buckeyelink-advising-ai.zip"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/buckeyelink-advising-ai.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"buckeyelink-advising-ai.zip\""
        }
      ]
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  }
}
